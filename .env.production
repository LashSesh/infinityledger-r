# Production Environment Configuration
ENVIRONMENT=production
AUTH_TOKEN_REQUIRED=true

# SECURITY NOTE: In production, use Docker Secrets or external secret management
# Example: MEF_API_TOKEN_FILE=/run/secrets/mef_api_token

BENCH_COMPARE=1
BENCH_TARGETS=mef,faiss,qdrant,milvus
TARGETS=mef,faiss,qdrant,milvus
REQUIRED_TARGETS=mef,faiss,qdrant,milvus
BENCH_POINTS=100000
BENCH_Q=200
COMPARE_LIMIT=1000
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true

# Production resource limits
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT=4G
API_MEMORY_RESERVATION=1G
QDRANT_CPU_LIMIT=4.0
QDRANT_MEMORY_LIMIT=4G
QDRANT_MEMORY_RESERVATION=1G
MILVUS_CPU_LIMIT=8.0
MILVUS_MEMORY_LIMIT=8G
MILVUS_MEMORY_RESERVATION=2G
