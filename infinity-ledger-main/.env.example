# Infinity Ledger - Environment Configuration Template
# Copy this file to .env and customize for your environment
# For production deployments, use Docker Secrets or external secret management (Vault, AWS Secrets Manager, etc.)

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Possible values: development, staging, production
ENVIRONMENT=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Whether API requires authentication tokens
AUTH_TOKEN_REQUIRED=false

# API tokens (use Docker Secrets in production: /run/secrets/mef_api_token)
MEF_API_TOKEN=
QUALITY_TOKEN=

# ============================================================================
# SERVICE ENDPOINTS
# ============================================================================
# API Service
QUALITY_BASE_URL=http://api:8080
BIND_HOST=0.0.0.0
PORT=8080

# Vector Database Services
QDRANT_URL=http://qdrant:6333
MILVUS_HOST=milvus
MILVUS_PORT=19530
WEAVIATE_URL=http://weaviate:8080
ELASTIC_URL=http://elasticsearch:9200
FAISS_URL=http://faiss-api:8090

# External Services (if applicable)
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# ============================================================================
# BENCHMARK CONFIGURATION
# ============================================================================
# Cross-DB compare settings
BENCH_COMPARE=1
BENCH_TARGETS=mef,faiss,qdrant,milvus
TARGETS=mef,faiss,qdrant,milvus
REQUIRED_TARGETS=mef,faiss,qdrant

# Dataset and query parameters
BENCH_POINTS=100000
BENCH_Q=200
BENCH_K=10
COMPARE_LIMIT=500
UPSERT_BATCH=2000

# Timeouts and retries
BENCH_TIMEOUT_SECONDS=1200
BENCH_CONNECT_TIMEOUT=240
BENCH_CONNECT_RETRY_DELAY=2
HTTPX_TIMEOUT=30.0

# Performance tuning
RECALL_EFSEARCH=128
HNSW_EF_SEARCH=64
FAISS_METRIC=cosine
FAISS_INDEX=flat
ANN_METRIC=cosine

# ============================================================================
# GOLDEN TEST CONFIGURATION
# ============================================================================
GOLDEN_STRICT=0
GOLDEN_COUNT=30
GOLDEN_MIN_OK=30
GOLDEN_ATTEMPTS_PER_SAMPLE=10
GOLDEN_ATTEMPTS_FACTOR=5
GOLDEN_HOLD_POLICY=
GOLDEN_SEED=1337

# ============================================================================
# CI/CD CONFIGURATION
# ============================================================================
CI_NO_POR_HOLDS=1
STRICT_READPATH=true

# ============================================================================
# RESOURCE LIMITS (Docker Compose)
# ============================================================================
# API Service
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_MEMORY_RESERVATION=512M

# Qdrant Service
QDRANT_CPU_LIMIT=2.0
QDRANT_MEMORY_LIMIT=2G
QDRANT_MEMORY_RESERVATION=512M

# Milvus Service (optimized for CI runners)
MILVUS_CPU_LIMIT=2.0
MILVUS_MEMORY_LIMIT=3G
MILVUS_MEMORY_RESERVATION=512M

# QA Container
QA_CPU_LIMIT=2.0
QA_MEMORY_LIMIT=4G
QA_MEMORY_RESERVATION=1G

# FAISS API
FAISS_CPU_LIMIT=2.0
FAISS_MEMORY_LIMIT=2G
FAISS_MEMORY_RESERVATION=512M

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# Prometheus
PROMETHEUS_RETENTION=15d

# ============================================================================
# UVICORN CONFIGURATION
# ============================================================================
UVICORN_WORKERS=2
