{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TIC",
  "type": "object",
  "properties": {
    "tic_id": {"type": "string"},
    "seed": {"type": "string"},
    "fixpoint": {"type": "array", "items": {"type": "number"}, "minItems": 5, "maxItems": 5},
    "window": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "invariants": {
      "type": "object",
      "properties": {
        "variance": {"type": "number"},
        "retention": {"type": "number"},
        "gap": {"type": "number"}
      },
      "required": ["variance", "retention", "gap"]
    },
    "sigma_bar": {
      "type": "object",
      "properties": {
        "psi": {"type": "number"},
        "rho": {"type": "number"},
        "omega": {"type": "number"}
      },
      "required": ["psi", "rho", "omega"]
    },
    "proof": {
      "type": "object",
      "properties": {
        "por": {"type": "string", "enum": ["valid", "invalid"]},
        "pi_gap": {"type": "number"},
        "mci": {"type": "number"}
      },
      "required": ["por", "pi_gap", "mci"]
    },
    "source_snapshot": {"type": "string"}
  },
  "required": ["tic_id", "seed", "fixpoint", "window", "invariants", "sigma_bar", "proof", "source_snapshot"]
}