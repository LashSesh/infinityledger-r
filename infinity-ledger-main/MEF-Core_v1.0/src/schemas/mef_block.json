{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEFBlock",
  "type": "object",
  "properties": {
    "index": {"type": "integer"},
    "previous_hash": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "tic_id": {"type": "string"},
    "snapshot_hash": {"type": "string"},
    "data": {"type": "object"},
    "proof": {
      "type": "object",
      "properties": {
        "por": {"type": "string", "enum": ["valid", "invalid"]},
        "pi_gap": {"type": "number"},
        "mci": {"type": "number"}
      },
      "required": ["por", "pi_gap", "mci"]
    },
    "hash": {"type": "string"}
  },
  "required": ["index", "previous_hash", "timestamp", "tic_id", "snapshot_hash", "data", "proof", "hash"]
}